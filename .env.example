# Prompt-Router Configuration

# Server Port and Host
PORT=4000
HOST=0.0.0.0

# TypeSafe Jev API Key (System One Non-Autoregressive Decision Model)
# Get your key at https://typesafe.ai
TYPESAFE_API_KEY=

# Mammouth AI API Key (Primary All-In-One LLM Provider for Claude, GPT, Gemini, DeepSeek)
# Get your key at https://mammouth.ai
MAMMOUTH_API_KEY=

# OpenRouter API Key (Alternative Multi-Provider Gateway)
# Get your key at https://openrouter.ai
OPENROUTER_API_KEY=

# Routing Strategy: cost_optimized | performance_optimized | balanced
ROUTING_STRATEGY=cost_optimized

# Preferred Downstream Provider: mammouth | openrouter
DEFAULT_PROVIDER=mammouth

# Site Metadata for OpenRouter rankings
SITE_URL=http://localhost:4000
SITE_NAME=Prompt-Router
